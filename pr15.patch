 src/markdownhighlighter.cpp | 20 ++++++++++--
 src/markdownhighlighter.h   |  3 +-
 tests/tst_omawrite.cpp      | 62 +++++++++++++++++++++++++++++++++++++
 6 files changed, 116 insertions(+), 13 deletions(-)

